# Copy this file to .env and edit. Everything here is optional — the tool
# works with no .env at all. Environment variables always beat this file.
#
#   cp .env.example .env
#
# .env is gitignored, so your keys and course URLs stay on your machine.


# ── What to process ───────────────────────────────────────────────────────
# The default for -i / --input. Set this and you can just run
# `python3 -m notesgen run` with no arguments.
#
# It accepts any ONE of:
#   a Udemy course URL      https://www.udemy.com/course/YOUR-COURSE-SLUG/
#   the extension's zip     /path/to/MyCourse-transcripts.zip
#   an extracted folder     /path/to/MyCourse
#   the folder above it     /path/to        (the course inside is found)
#
# One course at a time. For several courses, leave this unset and pass -i per
# run — each course gets its own folder under output/ and never mixes.
#
# NOTESGEN_INPUT=https://www.udemy.com/course/YOUR-COURSE-SLUG/


# ── What to produce ───────────────────────────────────────────────────────
# Comma-separated. Unset means everything local (no Drive upload).
#
#   notes        the Markdown notes  (always produced)
#   diagrams     system and flow diagrams per section
#   html         self-contained web page with a navigation sidebar
#   txt          plain text
#   md           one Markdown file per section
#   docx         Word documents
#   pdf          PDF, rendered from the web page
#   gdoc         a Google Doc in your Drive
#   drive-html   the web page on Drive, shareable by link
#   drive-pdf    the PDF on Drive, shareable by link
#
# Shortcuts: all | drive | web | word | markdown | text | pdfs
#
# Examples:
#   NOTESGEN_OUTPUTS=all              everything, including both Drive uploads
#   NOTESGEN_OUTPUTS=gdoc             just a Google Doc
#   NOTESGEN_OUTPUTS=drive-html       just the shareable web page
#   NOTESGEN_OUTPUTS=html             just a local web page
#   NOTESGEN_OUTPUTS=md               just Markdown
#   NOTESGEN_OUTPUTS=gdoc,drive-html  both Drive formats
#
# NOTESGEN_OUTPUTS=


# ── Which model writes the notes ──────────────────────────────────────────
# claude-cli | anthropic | openai | gemini
# Unset means: the claude CLI if installed, else whichever API key is set.
#
# NOTESGEN_PROVIDER=claude-cli

# Override the model. Leave unset for the provider's default.
#   claude-cli  sonnet | opus | haiku
#   anthropic   claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
#   openai      gpt-4o | gpt-4o-mini | gpt-4.1
#   gemini      gemini-2.5-flash | gemini-2.5-pro
#
# NOTESGEN_MODEL=

# Only needed for the API providers. claude-cli uses your Claude Code
# subscription and needs no key.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...


# ── Where things go ───────────────────────────────────────────────────────
# Generated notes, one folder per course.
# NOTESGEN_OUTPUT=./output

# Where zips are unpacked and URL fetches are saved.
# NOTESGEN_INPUT_DIR=./input

# The signed-in Chrome profile used by `fetch -i <udemy url>`. Kept outside
# the project by default: it holds a live Udemy session and should not travel
# with your transcripts if you copy or share that folder.
# NOTESGEN_BROWSER_PROFILE=~/.notesgen/browser-profile
